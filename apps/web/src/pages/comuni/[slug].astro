---
import Base from '../../layouts/Base.astro';
import { municipalities, formatDate } from '../../lib/model';
import { portal } from '../../lib/adapter';
import EventCard from '../../components/EventCard.astro';
import TechnicalTable from '../../components/TechnicalTable.astro';
import Timeline from '../../components/Timeline.astro';
import Empty from '../../components/Empty.astro';
export const getStaticPaths = () =>
  municipalities.map((m) => ({ params: { slug: m.slug }, props: { municipality: m } }));
const { municipality: m } = Astro.props;
const events = portal.data.recent_events.filter((e) => e.municipality_istat_codes.includes(m.code));
const technical = portal.data.technical_interventions.filter(
  (i) => i.municipality_istat_code === m.code,
);
const turns = portal.data.turnations.filter((t) => t.municipality_istat_code === m.code);
const ids = new Set([
  ...events.map((e) => e.event_id),
  ...technical.map((t) => t.intervention_id),
  ...turns.map((t) => t.turnation_id),
]);
const timeline = portal.data.timeline.filter((t) => ids.has(t.entity_id));
const lastObserved = [
  ...events.map((e) => e.acquired_at),
  ...technical.map((t) => t.last_seen_at),
  ...timeline.map((t) => t.observed_at),
]
  .sort((a, b) => Date.parse(a) - Date.parse(b))
  .at(-1);
const sources = [
  ...new Set([
    ...events.map((e) => e.source_url),
    ...technical.map((i) => i.source_url),
    ...turns.map((t) => t.source_url),
  ]),
];
---

<Base
  title={`${m.name}: acqua e aggiornamenti`}
  description={`Fonti, interventi e osservazioni sul servizio idrico a ${m.name}.`}
>
  <div class="wrap">
    <header class="page-head">
      <p class="breadcrumb">
        <a href="/comuni/">Comuni</a> / {m.name}
      </p>
      <p class="eyebrow">Comune · ISTAT {m.code}</p>
      <h1>{m.name}</h1>
      <p class="lead">
        Le informazioni disponibili per il territorio comunale, con provenienza e limiti espliciti.
      </p>
    </header>
    <div class="notice">
      <strong>Copertura delle fonti da verificare.</strong> La presenza in questa pagina non
      certifica che il comune sia servito da AICA o che tutte le criticità siano rappresentate.
    </div>
    <div class="grid-2" style="margin-top:24px">
      <div class="panel">
        <p class="eyebrow">Ultima osservazione nel dataset</p>
        <p>{formatDate(lastObserved, true)}</p>
      </div>
      <div class="panel">
        <p class="eyebrow">Stato del servizio</p>
        <p>Non determinabile dai dati disponibili.</p>
      </div>
    </div>
    <section class="section">
      <div class="section-title">
        <h2>Disservizi e aggiornamenti</h2>
        <a href={`/dashboard/?municipality=${m.code}`} class="text-link small">
          Filtra nella dashboard
        </a>
      </div>
      {events.length ? (
        <div class="grid-3">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      ) : (
        <Empty />
      )}
    </section>
    <section class="section" style="border-top:1px solid var(--line)">
      <h2 style="margin-bottom:24px">Interventi tecnici</h2>
      <TechnicalTable rows={technical} />
    </section>
    <div class="grid-2">
      <section class="panel">
        <h2 style="font-size:1.6rem;margin-bottom:25px">Timeline delle osservazioni</h2>
        <Timeline rows={timeline} />
      </section>
      <section class="panel">
        <h2 style="font-size:1.6rem;margin-bottom:22px">Turnazioni programmate</h2>
        {turns.length ? (
          <>
            <p class="small muted">Calendario dichiarato. Non certifica l’effettiva erogazione.</p>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Zona</th>
                    <th scope="col">Data</th>
                    <th scope="col">Orario / nota</th>
                  </tr>
                </thead>
                <tbody>
                  {turns.map((t) => (
                    <tr>
                      <td>{t.zone || 'Non disponibile'}</td>
                      <td>{formatDate(t.date)}</td>
                      <td>{t.time_slot || t.notes || 'Non specificato'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        ) : (
          <p class="muted">
            Nessun calendario validato con date complete disponibile. Non ricostruiamo le date
            mancanti usando il giorno di consultazione.
          </p>
        )}
      </section>
    </div>
    <section class="section">
      <h2 style="font-size:1.6rem;margin-bottom:20px">Fonti originali</h2>
      {sources.length ? (
        <ul>
          {sources.map((url) => (
            <li>
              <a href={url} class="text-link">
                Consulta il documento o l’avviso della fonte
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">
          Nessun documento pubblicabile associato al comune. Puoi consultare gli{' '}
          <a class="text-link" href="/fonti/">
            enti censiti
          </a>
          .
        </p>
      )}
    </section>
  </div>
</Base>
