---
import '../styles/global.css';
const categories = [
  ['Guasti', 'Segnalazioni esplicite di avarie da fonti ufficiali.'],
  ['Interventi programmati', 'Attività pianificate: non equivalgono a un guasto in corso.'],
  ['Ripristini confermati', 'Solo dichiarazioni esplicite della fonte, mai orari previsti.'],
];
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Osservatorio civico indipendente sulle risorse idriche della provincia di Agrigento." />
    <title>Vinnioi · Osservatorio civico dell’acqua</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <a href="#contenuto" class="sr-only focus:not-sr-only">Vai al contenuto</a>
    <header class="border-b border-slate-200 px-6 py-6"><div class="mx-auto max-w-5xl text-2xl font-bold text-water">Vinnioi <span class="text-sm font-normal">Provincia di Agrigento</span></div></header>
    <main id="contenuto" class="mx-auto max-w-5xl px-6 py-16">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-water">Indipendente · Open source · Apartitico</p>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight sm:text-6xl">Capire l’acqua, attraverso fonti verificabili.</h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-600">Un osservatorio civico su guasti, interruzioni, turnazioni e risorse idriche. Ispirato a OpenDataSicilia, con attenzione alla provenienza e ai limiti dei dati.</p>
      <section class="mt-10 rounded-xl border border-amber-300 bg-amber-50 p-6" aria-labelledby="stato">
        <h2 id="stato" class="text-xl font-semibold">Dati in fase di verifica</h2>
        <p class="mt-2">Non sono ancora disponibili eventi validati. L’assenza di dati non indica l’assenza di disservizi. Aggiornamenti automatici disattivati.</p>
      </section>
      <section class="mt-12 grid gap-6 md:grid-cols-3" aria-label="Come leggiamo le informazioni">
        {categories.map(([title, description]) => <article class="rounded-xl border border-slate-200 bg-white p-6"><h2 class="text-xl font-semibold text-water">{title}</h2><p class="mt-3 text-slate-600">{description}</p></article>)}
      </section>
      <section class="mt-12"><h2 class="text-2xl font-semibold">Fonti da consultare</h2><ul class="mt-4 flex flex-wrap gap-6 underline"><li><a href="https://www.aicaonline.it/interventi-programmati/">AICA</a></li><li><a href="https://www.siciliacque.it/">Siciliacque</a></li><li><a href="https://www.atiag9.it/">ATI AG9</a></li><li><a href="https://www.regione.sicilia.it/">Regione Siciliana</a></li></ul></section>
    </main>
    <footer class="mx-auto max-w-5xl px-6 py-8 text-sm text-slate-600">Vinnioi non è un canale ufficiale del gestore. <a class="underline" href="https://github.com/CarmeloB4/vinnioi-platform">Codice e metodologia</a></footer>
  </body>
</html>
