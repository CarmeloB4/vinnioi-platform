---
import Base from '../layouts/Base.astro';
---

<Base title="Pagina non trovata">
  <div class="wrap section">
    <p class="eyebrow">Errore 404</p>
    <h1>Questa pagina non è disponibile.</h1>
    <p class="lead">
      Il collegamento potrebbe essere cambiato. Le informazioni del territorio sono raggiungibili
      dall’elenco dei comuni.
    </p>
    <div class="actions">
      <a href="/comuni/" class="btn">
        Vai ai comuni
      </a>
      <a href="/" class="btn secondary">
        Torna alla panoramica
      </a>
    </div>
  </div>
</Base>
