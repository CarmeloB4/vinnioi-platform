{
  "$defs": {
    "ValidationStatus": {
      "enum": [
        "validated",
        "needs_review"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "turnation_id": {
      "title": "Turnation Id",
      "type": "string"
    },
    "source_id": {
      "const": "aica",
      "default": "aica",
      "title": "Source Id",
      "type": "string"
    },
    "source_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "calendar_version": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calendar Version",
      "type": "string"
    },
    "municipality": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Municipality"
    },
    "municipality_istat_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Municipality Istat Code"
    },
    "municipality_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Municipality Original"
    },
    "district": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "District"
    },
    "source_locator": {
      "title": "Source Locator",
      "type": "string"
    },
    "reservoir": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reservoir"
    },
    "zone": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zone"
    },
    "street_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Street Description"
    },
    "date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date"
    },
    "date_label_original": {
      "title": "Date Label Original",
      "type": "string"
    },
    "time_slot": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Time Slot"
    },
    "value_original": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value Original"
    },
    "valid_from": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Until"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "validation_status": {
      "$ref": "#/$defs/ValidationStatus",
      "default": "needs_review"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "data_origin": {
      "default": "real",
      "enum": [
        "real",
        "synthetic"
      ],
      "title": "Data Origin",
      "type": "string"
    },
    "actual_delivery_confirmed": {
      "const": false,
      "default": false,
      "title": "Actual Delivery Confirmed",
      "type": "boolean"
    }
  },
  "required": [
    "turnation_id",
    "source_url",
    "calendar_version",
    "source_locator",
    "date_label_original",
    "acquired_at"
  ],
  "title": "Turnation",
  "type": "object"
}
